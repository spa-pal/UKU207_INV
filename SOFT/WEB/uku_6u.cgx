t {
#				// блок "description" - описание изделия, структура	
c d01 "model": "%s",
#				//строка названия изделия	 
c d02 "serial": "%d",
#				//серийный номер
c d03 "place": "%s",
#				//место размещения
c d04 "numOfBat": "%d",
#				//количество батарей в структуре
c d05 "numOfSrc": "%d",
#				//количество источников в структуре
c d06 "numOfInv": "%d",
#				//количество инверторв в структуре
c d07 "numOfBypas": "%d",
#				//количество байпасов в структуре
c d08 "numOfSk": "%d",
#				//количество сухих контактов в структуре
c d09 "numOfDt": "%d",
#				//количество датчиков температуры в структуре
c d10 "numOfMakb": "%d",
#				//количество блоков МАКБ в структуре
c d11 "numOfMidPoint": "%d",
#				//количество средних точек на батарею в структуре
c d12 "batVolt": "%d",
#				//вольтаж батареи
c d13 "ulvbd": "%d",
#				//порог исправности батареи
c d14 "ubpske": "%d",
#				//напряжение источника при контроле емкости
c d15 "usign": "%d",
#				//сигнальное напряжение
c d16 "usign_makb": "%d",
#				//сигнальное напряжение поэлементное
#
c x   "autorised": "%s",
#				//авторизация
# 				//Аварии
c a01 "alarm_stat" : "%s",
#				//статус аварий
c a02 "alarm_text" : "%s",
#				//текст аварийных сообщений
#
#				//Первичное питание(сеть)
c pn  "powNum" : "%d",
#				// количество фаз
c pA  "powVoltA" : "%d",
#				// напряжение фазы A
c pB  "powVoltB" : "%d",
#				// напряжение фазы B
c pC  "powVoltC" : "%d",
#				// напряжение фазы C
c pF  "powFreq" : "%d",
#				// частота 0,1Гц
c pS  "powStat" : "%d",
#				// статус сети (0 - норма)
#
# 				//Батареи
c b1 "bat1Tm" : "%s",
#				//телеметрия 1 батареи
c b2 "bat2Tm" : "%s",
#				//телеметрия 2 батареи
c b3 "bat3Tm" : "%s",
#				//телеметрия 3 батареи
c b4 "bat4Tm" : "%s",
#				//телеметрия 4 батареи
#
#
# 				//Инверторы
c i01 "inv1Tm" : "%s",
#				//телеметрия 1 инвертора
c i02 "inv2Tm" : "%s",
#				//телеметрия 2 инвертора
c i03 "inv3Tm" : "%s",
#				//телеметрия 3 инвертора
c i04 "inv4Tm" : "%s",
#				//телеметрия 4 инвертора
c i05 "inv5Tm" : "%s",
#				//телеметрия 5 инвертора
c i06 "inv6Tm" : "%s",
#				//телеметрия 6 инвертора
c i07 "inv7Tm" : "%s",
#				//телеметрия 7 инвертора
c i08 "inv8Tm" : "%s",
#				//телеметрия 8 инвертора
c i09 "inv9Tm" : "%s",
#				//телеметрия 9 инвертора
c i10 "inv10Tm" : "%s",
#				//телеметрия 10 инвертора
c i11 "inv11Tm" : "%s",
#				//телеметрия 11 инвертора
c i12 "inv12Tm" : "%s",
#				//телеметрия 12 инвертора
c i13 "inv13Tm" : "%s",
#				//телеметрия 13 инвертора
c i14 "inv14Tm" : "%s",
#				//телеметрия 14 инвертора
c i15 "inv15Tm" : "%s",
#				//телеметрия 15 инвертора
c i16 "inv16Tm" : "%s",
#				//телеметрия 16 инвертора
#
# 				//Байпасы
c m01 "byp1Tm" : "%s",
#				//телеметрия 1 байпаса
c m02 "byp2Tm" : "%s",
#				//телеметрия 2 байпаса
c m03 "byp3Tm" : "%s",
#				//телеметрия 3 байпаса
#
# 				//Сухие контакты
c k1 "sk1Tm" : "%s",
#				//телеметрия 1 сухого контакта
c k2 "sk2Tm" : "%s",
#				//телеметрия 2 сухого контакта
c k3 "sk3Tm" : "%s",
#				//телеметрия 3 сухого контакта
c k4 "sk4Tm" : "%s",
#				//телеметрия 3 сухого контакта
#
# 				//Датчики температуры
c t1 "dt1Tm" : "%s",
#				//телеметрия 1 датчика температуры
c t2 "dt2Tm" : "%s",
#				//телеметрия 2 датчика температуры
c t3 "dt3Tm" : "%s",
#				//телеметрия 3 датчика температуры
#
# 				//Состояние выхода
c ou "loadUTm" : "%d",
#				//напряжение нагрузки
c oi "loadITm" : "%d",
#				//ток нагрузки
# 				//МАКБ
c h1 "makb1Tm" : "%s",
#				//телеметрия МАКБ1 
c h2 "makb2Tm" : "%s",
#				//телеметрия МАКБ2
c h3 "makb3Tm" : "%s",
#				//телеметрия МАКБ3
c h4 "makb4Tm" : "%s",
#				//телеметрия МАКБ4
# 				
c z "end" : "%s"
#				//конец файла
t }
.
