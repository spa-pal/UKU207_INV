t {
#				// блок "description" - описание изделия, структура	
c d01 "model": "%s",
#				//строка названия изделия	 
c d02 "serial": "%d",
#				//серийный номер
c d03 "place": "%s",
#				//место размещения
c d04 "numOfBat": "%d",
#				//количество батарей в структуре
c d05 "numOfOutPhases": "%d",
#				//количество выходных фаз в структуре
c d06 "numOfInv": "%d",
#				//количество инверторв в структуре
c d07 "numOfBypas": "%d",
#				//количество байпасов в структуре
c d08 "numOfSk": "%d",
#				//количество сухих контактов в структуре
c d09 "numOfDt": "%d",
#				//количество датчиков температуры в структуре
c d10 "numOfMakb": "%d",
#				//количество блоков МАКБ в структуре
c d11 "numOfMidPoint": "%d",
#				//количество средних точек на батарею в структуре
c d12 "batVolt": "%d",
#				//вольтаж батареи
c d13 "ulvbd": "%d",
#				//порог исправности батареи
c d14 "ubpske": "%d",
#				//напряжение источника при контроле емкости
c d15 "usign": "%d",
#				//сигнальное напряжение
c d16 "usign_makb": "%d",
#				//сигнальное напряжение поэлементное
#
c x   "autorised": "%s",
#				//авторизация
# 				//Аварии
c a01 "alarm_stat" : "%s",
#				//статус аварий
c a02 "alarm_text" : "%s",
#				//текст аварийных сообщений
#
#				//Первичное питание(сеть)
c pn  "powNum" : "%d",
#				// количество фаз
c pA  "powVoltA" : "%d",
#				// напряжение фазы A
c pB  "powVoltB" : "%d",
#				// напряжение фазы B
c pC  "powVoltC" : "%d",
#				// напряжение фазы C
c pF  "powFreq" : "%d",
#				// частота 0,1Гц
c pS  "powStat" : "%d",
#				// статус сети (0 - норма)
#
# 				//Байпасы
c b1 "byp1Tm" : "%s",
#				//телеметрия 1 байпаса
c b2 "byp2Tm" : "%s",
#				//телеметрия 2 байпаса
c b3 "byp3Tm" : "%s",
#				//телеметрия 3 байпаса
#
# 				//Статусная строка 
c f1 "stat_string" : "%s",
#				//Статусная строка
#
# 				//Инверторы
c i00 "inv1Tm" : "%s",
#				//телеметрия 1 инвертора
c i01 "inv2Tm" : "%s",
#				//телеметрия 2 инвертора
c i02 "inv3Tm" : "%s",
#				//телеметрия 3 инвертора
c i03 "inv4Tm" : "%s",
#				//телеметрия 4 инвертора
c i04 "inv5Tm" : "%s",
#				//телеметрия 5 инвертора
c i05 "inv6Tm" : "%s",
#				//телеметрия 6 инвертора
c i06 "inv7Tm" : "%s",
#				//телеметрия 7 инвертора
c i07 "inv8Tm" : "%s",
#				//телеметрия 8 инвертора
c i08 "inv9Tm" : "%s",
#				//телеметрия 9 инвертора
c i09 "inv10Tm" : "%s",
#				//телеметрия 10 инвертора
c i10 "inv11Tm" : "%s",
#				//телеметрия 11 инвертора
c i11 "inv12Tm" : "%s",
#				//телеметрия 12 инвертора
c i12 "inv13Tm" : "%s",
#				//телеметрия 13 инвертора
c i13 "inv14Tm" : "%s",
#				//телеметрия 14 инвертора
c i14 "inv15Tm" : "%s",
#				//телеметрия 15 инвертора
c i15 "inv16Tm" : "%s",
#				//телеметрия 16 инвертора
c i16 "inv17Tm" : "%s",
#				//телеметрия 17 инвертора
c i17 "inv18Tm" : "%s",
#				//телеметрия 18 инвертора
c i18 "inv19Tm" : "%s",
#				//телеметрия 19 инвертора
c i19 "inv20Tm" : "%s",
#				//телеметрия 20 инвертора
c i20 "inv21Tm" : "%s",
#				//телеметрия 21 инвертора
c i21 "inv22Tm" : "%s",
#				//телеметрия 22 инвертора
c i22 "inv23Tm" : "%s",
#				//телеметрия 23 инвертора
c i23 "inv24Tm" : "%s",
#				//телеметрия 24 инвертора
c i24 "inv25Tm" : "%s",
#				//телеметрия 25 инвертора
c i25 "inv26Tm" : "%s",
#				//телеметрия 26 инвертора
c i26 "inv27Tm" : "%s",
#				//телеметрия 27 инвертора
c i27 "inv28Tm" : "%s",
#				//телеметрия 28 инвертора
c i28 "inv29Tm" : "%s",
#				//телеметрия 29 инвертора
c i29 "inv30Tm" : "%s",
#				//телеметрия 30 инвертора
c i30 "inv31Tm" : "%s",
#				//телеметрия 31 инвертора
c i31 "inv32Tm" : "%s",
#				//телеметрия 32 инвертора
c i32 "inv33Tm" : "%s",
#				//телеметрия 33 инвертора
#
# 				//Нагрузка
c j1 "load1Tm" : "%s",
#				//телеметрия 1 нагрузки
c j2 "load2Tm" : "%s",
#				//телеметрия 2 нагрузки
c j3 "load3Tm" : "%s",
#				//телеметрия 3 нагрузки
#
# 				//Состояние выхода
c ou "loadUTm" : "%d",
#				//напряжение нагрузки
c oi "loadITm" : "%d",
#				//ток нагрузки
# 				//МАКБ
c h1 "makb1Tm" : "%s",
#				//телеметрия МАКБ1 
c h2 "makb2Tm" : "%s",
#				//телеметрия МАКБ2
c h3 "makb3Tm" : "%s",
#				//телеметрия МАКБ3
c h4 "makb4Tm" : "%s",
#				//телеметрия МАКБ4
# 				
c z "end" : "%s"
#				//конец файла
t }
.
